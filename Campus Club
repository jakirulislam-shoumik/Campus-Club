<!DOCTYPE html><html lang="en"><head>  <meta charset="UTF-8">  <meta name="viewport" content="width=device-width, initial-scale=1">  <title>Campus Clubs — Registration Portal</title>  <style>    :root {      --navy: #172554;      --blue: #3659e3;      --blue-light: #eef2ff;      --ink: #1e293b;      --muted: #64748b;      --line: #e2e8f0;      --bg: #f6f8fc;      --green: #15803d;      --amber: #a16207;      --red: #b91c1c;      --shadow: 0 8px 28px rgba(15, 23, 42, .055);    }
    * { box-sizing: border-box; }
    body {      margin: 0;      color: var(--ink);      background: var(--bg);      font: 15px/1.5 Inter, ui-sans-serif, system-ui, -apple-system,        BlinkMacSystemFont, "Segoe UI", sans-serif;    }
    button, input, select, textarea { font: inherit; }    button { cursor: pointer; }
    .sidebar {      position: fixed;      inset: 0 auto 0 0;      z-index: 5;      width: 245px;      padding: 24px 15px;      display: flex;      flex-direction: column;      color: #fff;      background: var(--navy);    }
    .brand {      display: flex;      align-items: center;      gap: 11px;      padding: 0 10px 30px;      font-size: 17px;      font-weight: 750;    }
    .brand-mark {      width: 36px;      height: 36px;      display: grid;      place-items: center;      border-radius: 11px;      background: #6178ed;      font-size: 19px;    }
    .nav-label {      margin: 10px 11px 8px;      color: #aab7d3;      font-size: 10px;      font-weight: 750;      letter-spacing: 1.2px;      text-transform: uppercase;    }
    .nav-list { display: grid; gap: 5px; }
    .nav-button {      width: 100%;      padding: 10px 12px;      display: flex;      align-items: center;      gap: 12px;      border: 0;      border-radius: 9px;      color: #d7def0;      background: transparent;      text-align: left;      transition: background .18s, color .18s;    }
    .nav-button:hover, .nav-button.active {      color: #fff;      background: #2b3d75;    }
    .nav-icon { width: 20px; text-align: center; font-size: 17px; }    .sidebar-footer { margin-top: auto; padding: 14px 11px 0; color: #b8c3dc; font-size: 12px; }
    .main { min-height: 100vh; margin-left: 245px; }
    .topbar {      position: sticky;      top: 0;      z-index: 3;      height: 70px;      padding: 0 32px;      display: flex;      align-items: center;      justify-content: space-between;      border-bottom: 1px solid var(--line);      background: rgba(255,255,255,.94);      backdrop-filter: blur(12px);    }
    .crumb { color: var(--muted); font-size: 13px; }    .top-actions { display: flex; align-items: center; gap: 14px; }    .today { color: var(--muted); font-size: 13px; }    .avatar {      width: 36px;      height: 36px;      display: grid;      place-items: center;      border-radius: 50%;      color: #273b9b;      background: #e0e7ff;      font-weight: 750;    }
    .content { max-width: 1440px; margin: auto; padding: 30px 32px 48px; }    .view { display: none; }    .view.active { display: block; }
    .page-heading {      display: flex;      align-items: flex-start;      justify-content: space-between;      gap: 18px;      margin-bottom: 23px;    }
    h1 { margin: 0; color: #172554; font-size: 27px; letter-spacing: -.7px; }    h2 { margin: 0; font-size: 16px; letter-spacing: -.2px; }    .subtitle { margin: 5px 0 0; color: var(--muted); }
    .button {      padding: 9px 13px;      display: inline-flex;      align-items: center;      justify-content: center;      gap: 7px;      border: 1px solid var(--line);      border-radius: 9px;      color: var(--ink);      background: #fff;      font-weight: 650;      transition: .18s ease;    }
    .button:hover { border-color: #a5b4fc; background: #f8faff; }    .button.primary { color: #fff; background: var(--blue); border-color: var(--blue); }    .button.primary:hover { background: #2848cc; }    .button.small { padding: 6px 9px; font-size: 12px; }    .button.danger { color: var(--red); }
    .stats {      display: grid;      grid-template-columns: repeat(4, minmax(0, 1fr));      gap: 15px;      margin-bottom: 18px;    }
    .stat-card, .panel {      border: 1px solid var(--line);      border-radius: 13px;      background: #fff;      box-shadow: var(--shadow);    }
    .stat-card { padding: 17px; }    .stat-top { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 13px; }    .stat-icon {      width: 34px;      height: 34px;      display: grid;      place-items: center;      border-radius: 10px;      color: var(--blue);      background: var(--blue-light);      font-size: 17px;    }    .stat-value { margin-top: 9px; font-size: 28px; font-weight: 760; letter-spacing: -.7px; }    .stat-note { margin-top: 1px; color: var(--muted); font-size: 12px; }
    .dashboard-grid {      display: grid;      grid-template-columns: minmax(0, 1.45fr) minmax(280px, .85fr);      gap: 17px;    }
    .panel { padding: 18px; margin-bottom: 17px; }    .panel-heading {      display: flex;      align-items: center;      justify-content: space-between;      gap: 12px;      margin-bottom: 14px;    }    .panel-sub { margin-top: 3px; color: var(--muted); font-size: 12px; }
    .event-list, .club-list { display: grid; gap: 10px; }    .event-card {      display: flex;      align-items: center;      gap: 12px;      padding: 12px;      border: 1px solid var(--line);      border-radius: 10px;    }
    .date-box {      width: 48px;      min-width: 48px;      height: 52px;      display: grid;      align-content: center;      border-radius: 9px;      color: #3149a4;      background: #eef2ff;      text-align: center;      line-height: 1.2;    }    .date-box strong { font-size: 18px; }    .date-box span { font-size: 10px; font-weight: 750; text-transform: uppercase; }    .event-info { min-width: 0; flex: 1; }    .event-info strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }    .event-info small { color: var(--muted); }    .event-side { display: grid; justify-items: end; gap: 6px; text-align: right; }
    .club-row {      display: flex;      align-items: center;      gap: 10px;      padding: 9px 0;      border-bottom: 1px solid #f1f5f9;    }    .club-row:last-child { border-bottom: 0; }    .club-symbol {      width: 38px;      height: 38px;      display: grid;      place-items: center;      border-radius: 11px;      background: #f1f5ff;      font-size: 18px;    }    .club-details { min-width: 0; flex: 1; }    .club-details strong { display: block; font-size: 13px; }    .club-details small, .club-count { color: var(--muted); font-size: 12px; }
    .toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }    .search { flex: 1; max-width: 360px; }    .search input, .field input, .field select, .field textarea {      width: 100%;      padding: 10px 11px;      border: 1px solid #dbe2ec;      border-radius: 8px;      color: var(--ink);      background: #fff;      outline: 0;    }    .search input:focus, .field input:focus, .field select:focus, .field textarea:focus {      border-color: #7c91f4;      box-shadow: 0 0 0 3px #e8edff;    }
    .table-wrap { overflow-x: auto; }    table { width: 100%; border-collapse: collapse; min-width: 620px; }    th {      padding: 10px 11px;      color: #718096;      background: #f8fafc;      text-align: left;      font-size: 11px;      letter-spacing: .5px;      text-transform: uppercase;    }    td { padding: 11px; border-top: 1px solid #edf1f6; font-size: 13px; }    td strong { font-weight: 650; }    .row-actions { display: flex; gap: 6px; }    .empty { padding: 28px 10px; color: var(--muted); text-align: center; }
    .badge {      display: inline-flex;      align-items: center;      padding: 3px 9px;      border-radius: 99px;      color: #475569;      background: #f1f5f9;      font-size: 11px;      font-weight: 700;      white-space: nowrap;    }    .badge.active, .badge.paid, .badge.attended { color: var(--green); background: #dcfce7; }    .badge.pending, .badge.registered { color: var(--amber); background: #fef3c7; }    .badge.inactive, .badge.cancelled, .badge.rejected, .badge.failed { color: var(--red); background: #fee2e2; }
    .modal-backdrop {      position: fixed;      inset: 0;      z-index: 10;      display: none;      align-items: center;      justify-content: center;      padding: 18px;      background: rgba(15, 23, 42, .48);    }    .modal-backdrop.open { display: flex; }    .modal {      width: min(540px, 100%);      max-height: 90vh;      overflow: auto;      padding: 22px;      border-radius: 15px;      background: #fff;      box-shadow: 0 20px 70px rgba(15, 23, 42, .25);    }    .modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 17px; }    .close { padding: 2px 5px; border: 0; color: var(--muted); background: transparent; font-size: 24px; }    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }    .field { display: grid; gap: 6px; }    .field.full { grid-column: 1 / -1; }    .field label { color: #475569; font-size: 12px; font-weight: 700; }    .field textarea { min-height: 76px; resize: vertical; }    .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }    .notice {      position: fixed;      right: 20px;      bottom: 20px;      z-index: 20;      padding: 12px 16px;      border-radius: 10px;      color: #fff;      background: #172554;      box-shadow: var(--shadow);      opacity: 0;      transform: translateY(8px);      transition: .2s ease;      pointer-events: none;    }    .notice.show { opacity: 1; transform: translateY(0); }
    @media (max-width: 1000px) {      .sidebar { width: 210px; }      .main { margin-left: 210px; }      .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }      .dashboard-grid { grid-template-columns: 1fr; }    }
    @media (max-width: 700px) {      .sidebar { width: 62px; padding: 16px 7px; }      .brand { justify-content: center; padding: 0 0 23px; }      .brand-name, .nav-label, .nav-text, .sidebar-footer { display: none; }      .nav-button { justify-content: center; padding: 11px 5px; }      .nav-icon { width: auto; }      .main { margin-left: 62px; }      .topbar { height: 60px; padding: 0 14px; }      .today { display: none; }      .content { padding: 22px 13px 36px; }      .page-heading { align-items: center; }      h1 { font-size: 22px; }      .page-heading .button { padding: 8px 10px; font-size: 12px; }      .stats { gap: 9px; }      .stat-card { padding: 12px; }      .stat-value { font-size: 23px; }      .panel { padding: 14px; }      .event-card { align-items: flex-start; }      .form-grid { grid-template-columns: 1fr; }      .field.full { grid-column: auto; }    }  </style></head><body>  <aside class="sidebar">    <div class="brand">      <span class="brand-mark">✦</span>      <span class="brand-name">Campus Clubs</span>    </div>    <div class="nav-label">Workspace</div>    <nav class="nav-list" aria-label="Main navigation">      <button class="nav-button active" data-view="overview"><span class="nav-icon">▦</span><span class="nav-text">Overview</span></button>      <button class="nav-button" data-view="clubs"><span class="nav-icon">◈</span><span class="nav-text">Clubs</span></button>      <button class="nav-button" data-view="events"><span class="nav-icon">▣</span><span class="nav-text">Events</span></button>      <button class="nav-button" data-view="students"><span class="nav-icon">♙</span><span class="nav-text">Students</span></button>      <button class="nav-button" data-view="registrations"><span class="nav-icon">☷</span><span class="nav-text">Event registrations</span></button>      <button class="nav-button" data-view="memberships"><span class="nav-icon">♧</span><span class="nav-text">Memberships</span></button>      <button class="nav-button" data-view="payments"><span class="nav-icon">＄</